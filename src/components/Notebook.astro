---
/** Marks a section students should copy into their lab record. */
interface Props {
  label?: string;
}
const { label = "Write in lab record" } = Astro.props;
---
<span
  class="nb-mark nb-mark-notebook not-prose inline-flex items-center gap-1.5 rounded-sm px-2 py-0.5 text-xs font-medium"
  role="note"
>
  <span aria-hidden="true" class="size-2 rounded-[2px] bg-current"></span>
  {label}
</span>
