---
import "../../../tokens.css";
import "../../styles/landing/workflow.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ThemeToggle } from "../../components/ui/theme-toggle";
import Notebook from "../../components/Notebook.astro";
import Explain from "../../components/Explain.astro";
import LanguagePicker from "../../components/LanguagePicker.astro";
import { loadCatalog, totals } from "../../lib/catalog";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;
const href = (p: string) => withBase(p, import.meta.env.BASE_URL);
const cat = await loadCatalog();
const t = totals(cat);
const run = [
  { lang: "C", check: "gcc --version", cmd: "gcc 1.c -o 1 && ./1" },
  { lang: "Python", check: "python3 --version", cmd: "python3 1.py" },
  { lang: "Rust", check: "rustc --version", cmd: "rustc 1.rs && ./1" },
  { lang: "TypeScript", check: "node --version", cmd: "node 1.ts" },
];
---

<BaseLayout title="Syntax Lab" description="Five steps from the lab manual to a finished lab record, for every IGNOU MCA lab session.">
  <div class="wf">
    <div class="wf-wrap">
      <header class="wf-mast">
        <p class="wf-mast-line">IGNOU MCA · Semesters 1 and 2 · {t.sessions} sessions</p>
        <h1 class="wf-mast-name">Syntax Lab</h1>
        <nav class="wf-mast-nav" aria-label="Primary">
          <ul>
            <li><a href="#stage-1">Sessions</a></li>
            <li><a href={href("/getting-started")}>Getting started</a></li>
            <li><a href="#stage-5">Downloads</a></li>
          </ul>
        </nav>
        <hr class="wf-mast-rule" aria-hidden="true" />
        <div class="wf-mast-tools"><ThemeToggle /></div>
      </header>

      <section class="wf-lede">
        <p>Five steps from the manual to a finished lab record.</p>
        <p class="muted">Every session here is already worked out. The steps below are how to use one without copying the whole page.</p>
      </section>

      <ol class="wf-stages">
        <li class="wf-stage" id="stage-1">
          <span class="wf-stage-n" aria-hidden="true">1.0</span>
          <div class="wf-stage-body">
            <h2>Find your session.</h2>
            <p>Sessions and exercise numbers match the official manuals, so the session you were given in the lab is the session here.</p>
            <ul class="wf-secs">
              {[1, 2].map((sem) => (
                <>
                  <li><span class="wf-sem-label">Semester {sem}</span></li>
                  {cat.filter((s) => s.semester === sem).map((s) => (
                    <li>
                      <a href={href(s.index)}>
                        <span class="wf-secs-code">{s.course}{s.section ? ` ${s.section.replace("Section ", "S")}` : ""}</span>
                        <span class="wf-secs-title">{s.title}</span>
                        <span class="wf-secs-count">{s.sessions.length} sessions</span>
                      </a>
                    </li>
                  ))}
                </>
              ))}
            </ul>
          </div>
        </li>

        <li class="wf-stage" id="stage-2">
          <span class="wf-stage-n" aria-hidden="true">2.0</span>
          <div class="wf-stage-body">
            <h2>Read what is marked.</h2>
            <p>Two marks sit under section headings. They decide what you copy and what you only read.</p>
            <div class="wf-marks">
              <div><Notebook /><span>Problem statement, algorithm, program, sample output. This is the record.</span></div>
              <div><Explain /><span>Explanations, complexity, demos. This is the viva.</span></div>
            </div>
          </div>
        </li>

        <li class="wf-stage" id="stage-3">
          <span class="wf-stage-n" aria-hidden="true">3.0</span>
          <div class="wf-stage-body">
            <h2>Run it yourself.</h2>
            <p>Every program is a plain file linked on its page. Where a solution comes in several languages, pick yours once; every page then opens on it.</p>
            <table class="wf-run">
              <thead><tr><th scope="col">Language</th><th scope="col">Check</th><th scope="col">Run</th></tr></thead>
              <tbody>
                {run.map((r) => (
                  <tr><td>{r.lang}</td><td><code>{r.check}</code></td><td><code>{r.cmd}</code></td></tr>
                ))}
              </tbody>
            </table>
            <div class="wf-picker"><LanguagePicker /></div>
          </div>
        </li>

        <li class="wf-stage" id="stage-4">
          <span class="wf-stage-n" aria-hidden="true">4.0</span>
          <div class="wf-stage-body">
            <h2>Write the record.</h2>
            <p>Three rules cover almost every marking scheme.</p>
            <ol class="wf-rules">
              <li><strong>One language.</strong> Where tabs offer several, write only the one your lab uses.</li>
              <li><strong>Every file.</strong> Where tabs are files of one project, all of them belong in the answer.</li>
              <li><strong>Your own description.</strong> Diagram and design sessions expect a 300 to 500 word problem description and assumptions in your words; the page gives you one to learn from, not to copy.</li>
            </ol>
          </div>
        </li>

        <li class="wf-stage" id="stage-5">
          <span class="wf-stage-n" aria-hidden="true">5.0</span>
          <div class="wf-stage-body">
            <h2>Print or download.</h2>
            <p>Each session page has a Print button and a PDF. Sections, courses and semesters come as ZIPs of those PDFs with the question paper included.</p>
            <ul class="wf-dl">
              <li><a href={href("/downloads/semester-1.zip")} download>Semester 1, all sessions (ZIP)</a></li>
              <li><a href={href("/downloads/semester-2.zip")} download>Semester 2, all sessions (ZIP)</a></li>
              <li><a href={href("/question-papers/mcsl-222-section-1")}>Question papers for Semester 2</a></li>
            </ul>
          </div>
        </li>
      </ol>

      <p class="wf-start"><a href="#stage-1">Start at stage 1</a></p>

      <footer class="wf-foot">
        Syntax Lab · Follows the IGNOU lab manuals for MCS-216, MCS-217, MCSL-222 and MCSL-223 · <a href={href("/important-notice")}>Notice on use</a> · <a href="https://github.com/theetherGit/mca-ignou-labs">Source</a> · MIT · 2026
      </footer>
    </div>
  </div>
</BaseLayout>
