{
  "name": "@ethercorps/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-zips.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "build:site": "astro build",
    "build:pdf": "astro build && node scripts/build-pdfs.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/svelte": "^9.0.1",
    "@cloudflare/nimbus-docs": "^0.14.2",
    "@daiji256/rehype-mathml": "^1.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@iconify-json/vscode-icons": "^1.2.81",
    "@iconify/utils": "^3.1.7",
    "astro": "7.3.1",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "remark-code-import": "^1.2.0",
    "remark-math": "^6.0.0",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.5.0",
    "temml": "^0.13.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@10.30.3"
}
