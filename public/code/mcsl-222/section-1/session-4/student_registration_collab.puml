@startuml
skinparam linetype polyline
title Collaboration Diagram - Student Registration (Register for Semester)

object "student" as student <<actor>>
object "s1 : Student" as s1
object "prog : Programme" as prog
object "reg : Registration" as reg
object "c1 : Course" as c1
object "enr : Enrolment" as enr
object "fee : FeeReceipt" as fee

student -right-> s1 : 1: register(semester, courseCodes)
s1 -right-> prog : 1.1: isEligible(s1, semester)
s1 -down-> reg : 1.2: <<create>> Registration(s1, semester)
reg -up-> prog : 1.3: getCourses(semester)
reg -down-> c1 : 1.4: hasSeat() [each course]
reg -down-> enr : 1.5: <<create>> Enrolment(reg, c1)
enr -left-> c1 : 1.5.1: reserveSeat()
s1 -left-> student : 1.6: fee due
student -down-> reg : 2: payFee(amount, mode)
reg -right-> fee : 2.1: <<create>> FeeReceipt(reg, amount, mode)
reg -> reg : 2.2: confirm()
reg -up-> s1 : 2.3: addRegistration(reg)
reg -left-> student : 2.4: registration slip
@enduml
