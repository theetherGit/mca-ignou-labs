@startuml
title Sequence Diagram - Employee Management System (Apply for Leave)

actor Employee as employee
participant "emp : Employee" as emp
participant "bal : LeaveBalance" as bal
participant "req : LeaveRequest" as req
participant "mgr : Manager" as mgr
actor Manager as manager

employee -> emp : 1: applyLeave(from, to, type)
activate emp
emp -> bal : 1.1: hasBalance(type, days)
activate bal
bal --> emp : true / false
deactivate bal
alt balance sufficient
  create req
  emp -> req : 1.2: <<create>> LeaveRequest(from, to, type)
  emp -> mgr : 1.3: forward(req)
  activate mgr
  deactivate mgr
  emp --> employee : 1.4: requestId
else insufficient
  emp --> employee : refused: shortfall
end
deactivate emp

manager -> mgr : 2: approve(requestId)
activate mgr
mgr -> req : 2.1: setStatus(Approved)
activate req
req -> emp : 2.2: notify(status)
activate emp
alt approved
  emp -> bal : 2.2.1: deduct(type, days)
else rejected
  note over emp, bal : balance unchanged
end
deactivate emp
deactivate req
mgr --> manager : 2.3: decision recorded
deactivate mgr
@enduml
