@startuml
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam classAttributeIconSize 0
title Class Diagram - Online Shopping System

class Customer {
  - customerId: int
  - name: String
  - email: String
  - phone: String
  + register()
  + login()
  + placeOrder()
}
class Address {
  - line1: String
  - city: String
  - pin: String
}
class ShoppingCart {
  - cartId: int
  - createdOn: Date
  + addItem(p: Product, qty: int)
  + removeItem(p: Product)
  + getTotal(): double
  + checkout(): Order
}
class CartItem {
  - quantity: int
  + subtotal(): double
}
class Category {
  - categoryId: int
  - name: String
}
class Product {
  - productId: int
  - name: String
  - price: double
  - stock: int
  + isAvailable(qty: int): boolean
  + reduceStock(qty: int)
  + restoreStock(qty: int)
}
class Admin {
  - adminId: int
  - name: String
  + addProduct()
  + updateStock()
  + shipOrder()
}
class Order {
  - orderId: int
  - orderDate: Date
  - status: String
  - total: double
  + confirm()
  + cancel()
  + track(): String
}
class OrderLine {
  - quantity: int
  - unitPrice: double
  + subtotal(): double
}
class Payment {
  - paymentId: int
  - amount: double
  - mode: String
  - status: String
  + process(): boolean
  + refund()
}
class Shipment {
  - shipmentId: int
  - courier: String
  - trackingNo: String
  - status: String
  + dispatch()
  + deliver()
}

Customer "1" -- "1..*" Address
Customer "1" *-- "1" ShoppingCart
ShoppingCart "1" *-- "0..*" CartItem
CartItem "0..*" --> "1" Product
Category "1" o-- "0..*" Product
Admin "1" -- "0..*" Product : manages
Customer "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderLine
OrderLine "0..*" --> "1" Product
Order "1" -- "1" Payment
Order "1" -- "0..1" Shipment
Order "0..*" --> "1" Address : delivered to
@enduml
