@startuml
skinparam defaultFontSize 16
skinparam ActivityFontSize 16
title Activity Diagram: Online Banking System (1 of 2: login and service menu)
|Customer|
start
:Open net banking site;
:Enter user ID and password;
|Web Server|
:Validate credentials;
if (credentials valid?) then (yes)
  :Show dashboard;
else (no)
  :Show login error;
  stop
endif
repeat
  |Customer|
  :Choose service;
  if (service?) then (view balance)
    |Core Banking|
    :Read account balance;
    |Web Server|
    :Display balance;
  else (fund transfer)
    |Customer|
    :Fund transfer
    (diagram 2 of 2);
  endif
  |Customer|
repeat while (another service?) is (yes) not (no)
:Logout;
|Web Server|
:End session;
stop
@enduml
