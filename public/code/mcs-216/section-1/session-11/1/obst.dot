// Optimal BST for the 7 keys of Q1 (cost 3.12). Keys are circles, dummy keys d_i squares.
digraph obst {
  graph [ordering=out, nodesep=0.3, ranksep=0.45, fontname="Helvetica"];
  node [fontname="Helvetica", fontsize=12, shape=circle, width=0.7, fixedsize=true];
  edge [arrowhead=none];
  k1 [label="k1\np=0.04"]; k2 [label="k2\np=0.06"]; k3 [label="k3\np=0.08"]; k4 [label="k4\np=0.02"];
  k5 [label="k5\np=0.10"]; k6 [label="k6\np=0.12"]; k7 [label="k7\np=0.14"];
  node [shape=box, width=0.55, height=0.45];
  d0 [label="d0\n0.06"]; d1 [label="d1\n0.06"]; d2 [label="d2\n0.06"]; d3 [label="d3\n0.06"];
  d4 [label="d4\n0.05"]; d5 [label="d5\n0.05"]; d6 [label="d6\n0.05"]; d7 [label="d7\n0.05"];
  k5 -> k2; k5 -> k7;
  k2 -> k1; k2 -> k3;
  k1 -> d0; k1 -> d1;
  k3 -> d2; k3 -> k4;
  k4 -> d3; k4 -> d4;
  k7 -> k6; k7 -> d7;
  k6 -> d5; k6 -> d6;
}
